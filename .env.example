# ASCA Environment Variables Template
# Copy to .env.local and fill in real values for local development.
# CI uses placeholder values defined in jest.setup.js (TEST_ENV_DEFAULTS).

# === Required ===

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/asca_dev"

# Supabase (https://supabase.com)
# ASCA-2026 project ref: caxjyimsuvjnbmjoxfad. Do not reuse the retired project URL.
# Native Auth runtime. Apply the reviewed auth migration before activating this branch.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Clerk credentials are no longer required by this branch. Preserve existing
# production Clerk settings outside this file until cutover/rollback validation.

# Application URL (CSRF Origin 화이트리스트의 주 소스)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# === Optional ===

# CSRF 화이트리스트 추가 호스트 (preview/staging/외부 도메인용, comma-separated).
# production 에서 NEXT_PUBLIC_APP_URL 외 다른 도메인에서 mutating API 호출이
# 필요한 경우에만 설정. 와일드카드 미지원 — 정확 hostname 만 허용.
# Vercel preview 는 자동 주입되는 VERCEL_URL 로 별도 처리되므로 여기 명시 불필요.
# CSRF_ALLOWED_ORIGINS="https://staging.asca.kr,https://preview.asca.kr"

# CSRF HTTPS scheme 강제. 미설정 시 NODE_ENV=production 자동 활성.
# production 인데 HTTPS 미사용하는 비표준 환경에서만 false 로 opt-out (권장 X).
# CSRF_ENFORCE_HTTPS="true"

# Database Replica (read-only)
# DATABASE_REPLICA_URL="postgresql://user:password@replica.host:5432/asca_dev"

# Redis for rate limiting (Upstash)
# UPSTASH_REDIS_REST_URL="https://YOUR.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# API Security (32+ chars)
# API_SECRET_KEY="your-32-character-secret-key-here-XXXXX"

# Airtable sync (legacy CMS integration)
# AIRTABLE_API_KEY="key..."
# AIRTABLE_BASE_ID="app..."

# Vercel
# VERCEL_TOOLBAR="1"

# Disposable local PostgreSQL for npm run test:auth-db (never a production URL).
# AUTH_TEST_DATABASE_URL="postgresql://user@127.0.0.1:55439/asca_auth_test_foundation"

# Supabase Auth SMTP is configured in the Supabase dashboard, not in NEXT_PUBLIC_*.
# Configure verified sender, Site URL and redirect allowlist before email testing.

# Archive object keys are relative; use NEXT_PUBLIC_SUPABASE_URL as the Storage origin.
NEXT_PUBLIC_ARCHIVE_PUBLIC_BUCKET="archive-public"
ARCHIVE_PRIVATE_BUCKET="archive-private"

# Tally 추천·초대작가 신청서 웹훅 (/api/webhooks/tally)
# Tally 폼 Integrations → Webhooks 의 Signing secret 과 같은 값. 비어 있으면 웹훅은 503.
TALLY_SIGNING_SECRET=""
# 받을 폼 ID (기본 w59jeo). 다른 폼의 웹훅은 저장하지 않는다.
TALLY_APPLICATION_FORM_ID="w59jeo"
